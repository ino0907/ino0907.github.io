function spawnConfetti(container, big){
  if(!container) return;
  const emojis = big
    ? ['🎉','🎊','⭐','✨','🏆','👑','🔥','💯','🥳']
    : ['🎉','✨','⭐','👏','🔥','💪','😆'];
  const count = big ? 18 : 10;
  for(let i = 0; i < count; i++){
    const span = document.createElement("span");
    span.className = "confetti-piece";
    span.textContent = emojis[Math.floor(Math.random() * emojis.length)];
    const angle = Math.random() * Math.PI * 2;
    const dist = 70 + Math.random() * (big ? 160 : 100);
    const dx = (Math.cos(angle) * dist).toFixed(0) + "px";
    const dy = (Math.sin(angle) * dist - (big ? 40 : 20)).toFixed(0) + "px";
    const rot = (Math.random() * 720 - 360).toFixed(0) + "deg";
    const size = (big ? 16 + Math.random() * 14 : 14 + Math.random() * 8).toFixed(0) + "px";
    span.style.setProperty("--dx", dx);
    span.style.setProperty("--dy", dy);
    span.style.setProperty("--rot", rot);
    span.style.fontSize = size;
    span.style.animationDuration = (big ? 1.1 : 0.85) + "s";
    container.appendChild(span);
    setTimeout(() => span.remove(), big ? 1200 : 900);
  }
}

function computePointsDelta(isCorrect, elapsedSec){
  if(!isCorrect) return -10;
  if(elapsedSec <= 5) return 10;
  if(elapsedSec <= 10) return 5;
  if(elapsedSec <= 15) return 2;
  return 1;
}

function applyScore(entry, pointsDelta){
  entry.score = Math.max(SCORE_MIN, entry.score + pointsDelta);
  let justGraduated = false;
  if(entry.score >= GRADUATION_SCORE){
    entry.score = GRADUATION_SCORE;
    if(!entry.graduated){ entry.graduated = true; justGraduated = true; }
  }
  return justGraduated;
}

async function answer(selected, btnEl){
  if(locked || !currentWord) return;
  locked = true;
  const correctAnswer = mode === "e2j" ? currentWord.jp : currentWord.w;
  const isCorrect = selected === correctAnswer;
  const entry = ensureProgress(currentWord.id);
  const elapsedSec = (Date.now() - (questionStartTime || Date.now())) / 1000;
  const pointsDelta = computePointsDelta(isCorrect, elapsedSec);
  const justGraduated = applyScore(entry, pointsDelta);

  const allButtons = document.querySelectorAll(".choice");
  allButtons.forEach(b => {
    b.disabled = true;
    if(b.dataset.value === correctAnswer) b.classList.add("correct");
    else if(b === btnEl && !isCorrect) b.classList.add("wrong");
  });

  const toastEl = document.getElementById("toast");
  const cardEl = document.getElementById("quiz-card");

  if(isCorrect){
    if(justGraduated){
      if(toastEl) toastEl.textContent = randomFrom(MASTER_PHRASES);
    } else if(toastEl){
      let msg = `${randomFrom(PRAISE_PHRASES)}　+${pointsDelta}点 (${entry.score}/100)`;
      if(entry.score >= 90) msg += `　${randomFrom(NEAR_MASTER_EXTRA)}`;
      toastEl.textContent = msg;
    }
    if(cardEl){
      cardEl.classList.remove("card-correct-pulse");
      void cardEl.offsetWidth; // restart animation
      cardEl.classList.add("card-correct-pulse");
      spawnConfetti(cardEl, justGraduated);
    }
    if(toastEl){
      toastEl.classList.remove("toast-correct", "toast-master", "toast-wrong");
      void toastEl.offsetWidth;
      toastEl.classList.add("toast-correct");
      if(justGraduated) toastEl.classList.add("toast-master");
    }
  }else{
    if(toastEl){
      toastEl.textContent = `${randomFrom(TAUNT_PHRASES)}　${pointsDelta}点 (${entry.score}/100)　正解は「${correctAnswer}」`;
      toastEl.classList.remove("toast-correct", "toast-master");
      toastEl.classList.remove("toast-wrong");
      void toastEl.offsetWidth;
      toastEl.classList.add("toast-wrong");
    }
    if(cardEl){
      cardEl.classList.remove("card-wrong-shake");
      void cardEl.offsetWidth;
      cardEl.classList.add("card-wrong-shake");
    }
  }

  updateScoreMeter(entry);
  updateStats();
  roundState.count += 1;
  roundState.points += pointsDelta;
  if(isCorrect) roundState.correct += 1;
  await saveProgress();

  const roundDone = roundState.count >= ROUND_SIZE;
  showNextButton(roundDone, () => {
    if(roundDone){
      pushRoundHistory(roundHistory, roundState);
      saveProgress();
      currentView = "round-summary";
      render();
    } else {
      nextQuestion();
    }
  });
}

