const GRADUATION_SCORE = 100;
const SCORE_MIN = -50;
const ROUND_SIZE = 10;
const MAX_ROUND_HISTORY = 100;
const STORAGE_KEY = "progress:v1";

let progress = {};   // { id: { score: number, graduated: bool } }
let mode = "e2j";    // "e2j" or "j2e"
let levelFilter = "all";  // "all" | "準2級" | "2級"
let typeFilter = "all";   // "all" | "単語" | "熟語"
let currentView = "quiz"; // "quiz" | "list" | "round-summary" | "history"
let listSearch = "";
let choiceCount = 4; // 4 | 8 | 10 | 20
let currentWord = null;
let currentChoices = [];
let locked = false;
let questionStartTime = null;
let roundState = { count: 0, correct: 0, points: 0 };
let roundHistory = []; // [{correct, total, points, ts}]

let appSection = "word"; // "word" | "quote"
let quoteProgress = {};
let quoteMode = "q2a";   // "q2a" (quote -> author) | "q2j" (quote -> Japanese translation)
let quoteCategoryFilter = "all";
let quoteView = "quiz";  // "quiz" | "list" | "round-summary" | "history"
let quoteListSearch = "";
