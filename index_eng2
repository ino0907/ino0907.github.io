}

function buildRoundChart(history){
  if(history.length === 0){
    return `<div class="empty-note">まだラウンドの記録がありません。10問終えると、ここにグラフが表示されます。</div>`;
  }

  const barW = 22, gap = 6, padTop = 18, padBottom = 34, chartH = 200;
  const zeroCapableMax = Math.max(10, ...history.map(h => Math.abs(h.points)));
  const usableH = chartH - padTop - padBottom;
  const zeroY = padTop + usableH * (zeroCapableMax / (2 * zeroCapableMax));
  const scale = (usableH / 2) / zeroCapableMax;
  const width = Math.max(320, history.length * (barW + gap) + gap);

  const bars = history.map((h, i) => {
    const x = gap + i * (barW + gap);
    const isPos = h.points >= 0;
    const barH = Math.max(2, Math.abs(h.points) * scale);
    const y = isPos ? zeroY - barH : zeroY;
    const color = isPos ? "var(--green)" : "var(--coral)";
    const acc = h.correct / h.total; // 0..1
    const heatColor = accuracyColor(acc);
    const roundNum = i + 1;
    const showLabel = history.length <= 20 || roundNum % 5 === 0 || roundNum === 1 || roundNum === history.length;
    return `
      <g>
        <title>ラウンド${roundNum}: ${h.correct}/${h.total}正解, ${h.points >= 0 ? '+' : ''}${h.points}点</title>
        <rect x="${x}" y="${y}" width="${barW}" height="${barH}" fill="${color}" rx="3"></rect>
        <rect x="${x}" y="${chartH - padBottom + 8}" width="${barW}" height="10" fill="${heatColor}" rx="2"></rect>
        ${showLabel ? `<text x="${x + barW/2}" y="${chartH - padBottom + 32}" text-anchor="middle" class="chart-axis-label">${roundNum}</text>` : ""}
      </g>
    `;
  }).join("");

  return `
    <div class="chart-scroll">
      <svg width="${width}" height="${chartH}" viewBox="0 0 ${width} ${chartH}">
        <line x1="0" y1="${zeroY}" x2="${width}" y2="${zeroY}" stroke="#3A4356" stroke-width="1" stroke-dasharray="3,3"></line>
        <text x="4" y="${zeroY - 4}" class="chart-axis-label chart-axis-label-left">0</text>
        ${bars}
      </svg>
    </div>
    <div class="chart-legend">
      <span><i class="legend-dot" style="background:var(--green)"></i>プラス点</span>
      <span><i class="legend-dot" style="background:var(--coral)"></i>マイナス点</span>
      <span><i class="legend-dot heat-gradient"></i>正答率(下段)</span>
    </div>
  `;
}

function accuracyColor(acc){
  // acc: 0 (all wrong) -> coral, 1 (all correct) -> green
  const r1 = 210, g1 = 96, b1 = 74;   // coral
  const r2 = 79, g2 = 157, b2 = 105;  // green
  const r = Math.round(r1 + (r2 - r1) * acc);
  const g = Math.round(g1 + (g2 - g1) * acc);
  const b = Math.round(b1 + (b2 - b1) * acc);
  return `rgb(${r},${g},${b})`;
}

function historySummary(history){
  if(history.length === 0) return null;
  const totalPoints = history.reduce((a,h) => a + h.points, 0);
  const avgPoints = totalPoints / history.length;
  const totalCorrect = history.reduce((a,h) => a + h.correct, 0);
  const totalQuestions = history.reduce((a,h) => a + h.total, 0);
  const avgAccuracy = totalQuestions ? (totalCorrect / totalQuestions * 100) : 0;
  const best = history.reduce((a,h) => h.points > a.points ? h : a, history[0]);
  const bestIdx = history.indexOf(best) + 1;
  return { count: history.length, avgPoints, avgAccuracy, bestPoints: best.points, bestIdx };
}

