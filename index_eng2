    <div class="round-indicator">問題 ${Math.min(roundState.count + 1, ROUND_SIZE)} / ${ROUND_SIZE}　・　このラウンド ${roundState.points >= 0 ? '+' : ''}${roundState.points}点</div>

    <div class="card" id="quiz-card">
      <div class="pos">${posLabel}</div>
      <div class="${promptClass}">${promptText}</div>
    </div>

    <div class="toast" id="toast"></div>

    <div class="choices ${choiceCount > 8 ? 'choices-compact' : ''}" id="choices"></div>

    <div class="next-btn-wrap" id="next-btn-wrap"></div>

    ${scoreMeterHTML(entry)}

    <footer>
      <button onclick="resetAll()">この範囲の記録をリセット</button>
      <span class="footer-sep">・</span>
      <button id="view-list-2">📋 進捗一覧を見る</button>
      <span class="footer-sep">・</span>
      <button id="view-history-2">📊 ラウンド履歴</button>
    </footer>
  `;

  wireSectionNav();
  document.getElementById("mode-e2j").onclick = () => setMode("e2j");
  document.getElementById("mode-j2e").onclick = () => setMode("j2e");
  document.getElementById("view-list-2").onclick = () => setView("list");
  document.getElementById("view-history-2").onclick = () => setView("history");
  wireFilterBar();

  const choicesEl = document.getElementById("choices");
  currentChoices.forEach(opt => {
    const btn = document.createElement("button");
    btn.className = mode === "j2e" ? "choice choice-en" : "choice";
    if(choiceCount > 8) btn.classList.add("choice-compact");
    btn.textContent = opt;
    btn.dataset.value = opt;
    btn.onclick = () => answer(opt, btn);
    choicesEl.appendChild(btn);
  });
}

function renderQuoteQuiz(){
  const scope = scopedQuotes();
  const total = scope.length;
  const masteredCount = scope.filter(q => quoteProgress[q.id]?.graduated).length;
  const learningCount = total - masteredCount;

  if(!currentQuote){
    app.innerHTML = `
      ${sectionNav()}
      <header>
        <div class="title-block">
          <span class="eyebrow">Famous Quotes</span>
          <h1>名言クイズ</h1>
        </div>
        <div class="mode-toggle">
          <button id="quote-view-list">📋 一覧</button>
        </div>
      </header>
      ${quoteFilterBar({showChoiceCount:true})}
      <div class="done">
        <div class="big">${total > 0 ? "この範囲は卒業達成！🏆" : "この範囲に名言がありません"}</div>
        <p>${total > 0 ? `「${quoteScopeLabel()}」の${total}件すべてで100点を達成し、卒業しました。` : "上の範囲を変えてみてください。"}<br>お疲れさまでした。</p>
      </div>
      <footer><button onclick="resetAllQuotes()">この範囲の記録をリセット</button></footer>
    `;
    wireSectionNav();
    wireQuoteFilterBar();
    const vb = document.getElementById("quote-view-list");
    if(vb) vb.onclick = () => setQuoteView("list");
    return;
  }

  const promptText = currentQuote.en;
  const posLabel = quoteMode === "q2a" ? `名言・作者を当てよう・${currentQuote.category}` : `名言・日本語訳を当てよう・${currentQuote.category}`;
  const entry = ensureQuoteProgress(currentQuote.id);

  app.innerHTML = `
    ${sectionNav()}
    <header>
      <div class="title-block">
        <span class="eyebrow">Famous Quotes</span>
        <h1>名言クイズ</h1>
      </div>
      <div class="mode-toggle">
        <button id="quote-mode-a" class="${quoteMode==='q2a' ? 'active':''}">誰の名言？</button>
        <button id="quote-mode-j" class="${quoteMode==='q2j' ? 'active':''}">日本語訳は？</button>
      </div>
    </header>

    ${quoteFilterBar({showChoiceCount:true})}

    <div class="stats">
      <div class="stat mastered">
        <div class="num" id="stat-mastered">${masteredCount}</div>
        <div class="label">卒業済み</div>
      </div>
      <div class="stat learning">
        <div class="num" id="stat-learning">${learningCount}</div>
        <div class="label">学習中</div>
      </div>
    </div>
    <div class="bar-track"><div class="bar-fill" id="bar-fill" style="width:${(total ? (masteredCount/total)*100 : 0).toFixed(1)}%"></div></div>

    <div class="round-indicator">問題 ${Math.min(quoteRoundState.count + 1, ROUND_SIZE)} / ${ROUND_SIZE}　・　このラウンド ${quoteRoundState.points >= 0 ? '+' : ''}${quoteRoundState.points}点</div>

    <div class="card quote-card" id="quiz-card">
      <div class="pos">ENGLISH QUOTE</div>
      <div class="prompt quote-prompt">“${promptText}”</div>
    </div>

    <div class="toast" id="toast"></div>

    <div class="choices ${choiceCount > 8 ? 'choices-compact' : ''}" id="choices"></div>

    <div class="next-btn-wrap" id="next-btn-wrap"></div>

    ${scoreMeterHTML(entry)}

    <footer>
      <button onclick="resetAllQuotes()">この範囲の記録をリセット</button>
      <span class="footer-sep">・</span>
      <button id="quote-view-list-2">📋 進捗一覧を見る</button>
      <span class="footer-sep">・</span>
      <button id="quote-view-history-2">📊 ラウンド履歴</button>
    </footer>
  `;

  wireSectionNav();
  document.getElementById("quote-mode-a").onclick = () => setQuoteMode("q2a");
  document.getElementById("quote-mode-j").onclick = () => setQuoteMode("q2j");
  document.getElementById("quote-view-list-2").onclick = () => setQuoteView("list");
  document.getElementById("quote-view-history-2").onclick = () => setQuoteView("history");
  wireQuoteFilterBar();

  const choicesEl = document.getElementById("choices");
  currentQuoteChoices.forEach(opt => {
    const btn = document.createElement("button");
    btn.className = "choice";
    if(choiceCount > 8) btn.classList.add("choice-compact");
    btn.textContent = opt;
    btn.dataset.value = opt;
    btn.onclick = () => answerQuote(opt, btn);
    choicesEl.appendChild(btn);
  });
}

function renderQuoteList(){
  const scope = scopedQuotes();
  const total = scope.length;
  const masteredCount = scope.filter(q => quoteProgress[q.id]?.graduated).length;
  const learningCount = total - masteredCount;

  const s = quoteListSearch.trim().toLowerCase();
  const rows = scope
    .filter(q => !s || q.en.toLowerCase().includes(s) || q.jp.includes(s) || q.author.toLowerCase().includes(s))
    .sort((a,b) => a.author.localeCompare(b.author));

  app.innerHTML = `
    ${sectionNav()}
    <header>
      <div class="title-block">
        <span class="eyebrow">Famous Quotes</span>
        <h1>進捗一覧</h1>
      </div>
      <div class="mode-toggle">
        <button id="quote-back-to-quiz">← 出題に戻る</button>
      </div>
    </header>

    ${quoteFilterBar()}

    <div class="stats">
      <div class="stat mastered">
        <div class="num">${masteredCount}</div>
        <div class="label">卒業済み</div>
      </div>
      <div class="stat learning">
        <div class="num">${learningCount}</div>
        <div class="label">学習中</div>
      </div>
      <div class="stat total">
        <div class="num">${total}</div>
        <div class="label">対象件数</div>
      </div>
    </div>
    <div class="bar-track"><div class="bar-fill" style="width:${(total ? (masteredCount/total)*100 : 0).toFixed(1)}%"></div></div>

    <input type="text" id="quote-list-search" class="search-input" placeholder="名言・作者・訳で検索…" value="${quoteListSearch.replace(/"/g,'&quot;')}">

    <div class="word-list">
      ${rows.length === 0 ? `<div class="empty-note">該当する名言がありません</div>` : rows.map(q => {
        const entry = ensureQuoteProgress(q.id);
        return `
          <div class="word-row ${entry.graduated ? 'is-mastered':''}">
            <div class="word-row-main">
              <div class="word-row-en">${q.author}</div>
              <div class="word-row-jp">${q.en}</div>
              <div class="word-row-tag">${q.category}</div>
            </div>
            <div class="word-row-progress">
              ${entry.graduated ? `<span class="badge-done">卒業済み</span>` : progressDots(entry, true)}
            </div>
          </div>
        `;
      }).join("")}
    </div>
  `;

  wireSectionNav();
  document.getElementById("quote-back-to-quiz").onclick = () => setQuoteView("quiz");
  wireQuoteFilterBar();
  const searchEl = document.getElementById("quote-list-search");
  searchEl.oninput = (e) => { quoteListSearch = e.target.value; renderQuoteList(); };
  searchEl.focus();
  searchEl.setSelectionRange(searchEl.value.length, searchEl.value.length);
}

function wireFilterBar(){
  const lvEl = document.getElementById("level-filter");
  const tpEl = document.getElementById("type-filter");
  const ccEl = document.getElementById("choice-count-filter");
  if(lvEl) lvEl.onchange = (e) => setLevelFilter(e.target.value);
  if(tpEl) tpEl.onchange = (e) => setTypeFilter(e.target.value);
  if(ccEl) ccEl.onchange = (e) => setChoiceCount(e.target.value);
}

function wireQuoteFilterBar(){
  const catEl = document.getElementById("quote-category-filter");
  const ccEl = document.getElementById("choice-count-filter");
  if(catEl) catEl.onchange = (e) => setQuoteCategoryFilter(e.target.value);
  if(ccEl) ccEl.onchange = (e) => setChoiceCount(e.target.value);
}

async function init(){
  await loadProgress();
  if(appSection === "quote"){
    nextQuoteQuestion();
  } else {
    nextQuestion();
  }
  if(!storageOK){
    console.warn("Storage unavailable — progress will not persist between sessions.");
  }
}

init();
</script>
</body>
</html>
