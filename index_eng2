<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>単語帳 — 英検2級トレーナー</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Manrope:wght@600;700;800&family=IBM+Plex+Sans+JP:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink: #12161F;
    --ink-soft: #1B2130;
    --paper: #F1E9D8;
    --paper-soft: #E9DFC9;
    --gold: #C9963B;
    --gold-dim: #7A6640;
    --green: #4F9D69;
    --coral: #D2604A;
    --text-on-ink: #EDE6D6;
    --text-muted: #8890A0;
    --text-on-paper: #1B2430;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background: var(--ink);
    color: var(--text-on-ink);
    font-family: 'IBM Plex Sans JP', sans-serif;
    min-height:100vh;
    display:flex;
    justify-content:center;
    padding: 24px 16px 48px;
  }
  .app{
    width:100%;
    max-width: 480px;
  }
  header{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    margin-bottom: 22px;
    gap: 12px;
  }
  .title-block h1{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size: 22px;
    letter-spacing: 0.01em;
    margin: 0;
    color: var(--text-on-ink);
  }
  .title-block .eyebrow{
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 4px;
    display:block;
  }
  .mode-toggle{
    display:flex;
    background: var(--ink-soft);
    border-radius: 999px;
    padding: 3px;
    border: 1px solid #2A3140;
    flex-shrink:0;
  }
  .mode-toggle button{
    border:none;
    background:transparent;
    color: var(--text-muted);
    font-family:inherit;
    font-size: 12px;
    font-weight:600;
    padding: 7px 12px;
    border-radius: 999px;
    cursor:pointer;
    transition: all .2s ease;
    white-space:nowrap;
  }
  .mode-toggle button.active{
    background: var(--gold);
    color: var(--ink);
  }

  .section-nav{
    display:flex;
    gap: 8px;
    margin-bottom: 18px;
    background: var(--ink-soft);
    border: 1px solid #2A3140;
    border-radius: 12px;
    padding: 4px;
  }
  .section-nav button{
    flex:1;
    border:none;
    background:transparent;
    color: var(--text-muted);
    font-family:inherit;
    font-size: 13px;
    font-weight:700;
    padding: 9px 10px;
    border-radius: 9px;
    cursor:pointer;
    transition: all .2s ease;
  }
  .section-nav button.active{
    background: var(--gold);
    color: var(--ink);
  }

  .quote-card{
    padding: 30px 22px;
  }
  .card .quote-prompt{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 600;
    font-size: 21px;
    line-height: 1.45;
  }

  .filter-row{
    display:flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }
  .filter-row select{
    flex: 1 1 100px;
    min-width: 0;
    background: var(--ink-soft);
    border: 1px solid #2A3140;
    color: var(--text-on-ink);
    font-family: inherit;
    font-size: 12px;
    padding: 8px 10px;
    border-radius: 8px;
    cursor:pointer;
  }
  .filter-row select#choice-count-filter{
    flex: 0 0 72px;
  }
  .filter-row select:focus{
    outline: 2px solid var(--gold);
    outline-offset: 1px;
  }

  .stat.total .num{ color: var(--text-on-ink); }

  .search-input{
    width:100%;
    background: var(--ink-soft);
    border: 1px solid #2A3140;
    color: var(--text-on-ink);
    font-family: inherit;
    font-size: 13px;
    padding: 10px 12px;
    border-radius: 10px;
    margin-bottom: 14px;
  }
  .search-input:focus{
    outline: 2px solid var(--gold);
    outline-offset: 1px;
  }

  .word-list{
    display:flex;
    flex-direction:column;
    gap: 6px;
    max-height: 62vh;
    overflow-y:auto;
    padding-right: 2px;
  }
  .word-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap: 10px;
    background: var(--ink-soft);
    border: 1px solid #2A3140;
    border-radius: 10px;
    padding: 10px 12px;
  }
  .word-row.is-mastered{
    border-color: rgba(79,157,105,0.4);
    background: rgba(79,157,105,0.07);
  }
  .word-row-main{ min-width:0; }
  .word-row-en{
    font-family:'Manrope', sans-serif;
    font-weight:700;
    font-size: 14px;
    color: var(--text-on-ink);
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }
  .word-row-jp{
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }
  .word-row-tag{
    font-size: 10px;
    color: var(--gold-dim);
    margin-top: 3px;
    letter-spacing: 0.03em;
  }
  .word-row-progress{ flex-shrink:0; }
  .badge-done{
    font-size: 11px;
    font-weight:600;
    color: var(--green);
    background: rgba(79,157,105,0.14);
    padding: 4px 9px;
    border-radius: 999px;
    white-space:nowrap;
  }
  .punch-sm{ gap: 5px; margin: 0; }
  .dot-sm{ width: 8px; height: 8px; }
  .empty-note{
    text-align:center;
    color: var(--text-muted);
    font-size: 13px;
    padding: 30px 0;
  }
  .footer-sep{ color: var(--text-muted); margin: 0 4px; font-size:12px; }

  .stats{
    display:flex;
    gap: 10px;
    margin-bottom: 20px;
  }
  .stat{
    flex:1;
    background: var(--ink-soft);
    border: 1px solid #2A3140;
    border-radius: 10px;
    padding: 10px 12px;
  }
  .stat .num{
    font-family:'Fraunces', serif;
    font-size: 20px;
    font-weight:700;
    color: var(--text-on-ink);
    line-height:1;
  }
  .stat .label{
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 4px;
  }
  .stat.mastered .num{ color: var(--green); }
  .stat.learning .num{ color: var(--gold); }

  .bar-track{
    height: 6px;
    background: var(--ink-soft);
    border-radius: 999px;
    overflow:hidden;
    margin-bottom: 26px;
    border: 1px solid #2A3140;
  }
  .bar-fill{
    height:100%;
    background: linear-gradient(90deg, var(--gold-dim), var(--gold));
    border-radius: 999px;
    transition: width .4s ease;
  }

  .card{
    background: var(--paper);
    color: var(--text-on-paper);
    border-radius: 18px;
    padding: 34px 24px 26px;
    text-align:center;
    box-shadow: 0 18px 40px -18px rgba(0,0,0,0.6);
    position:relative;
    min-height: 150px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    margin-bottom: 14px;
  }
  @keyframes cardCorrectPulse{
    0%   { box-shadow: 0 18px 40px -18px rgba(0,0,0,0.6), 0 0 0 0 rgba(79,157,105,0.6); }
    30%  { box-shadow: 0 18px 40px -18px rgba(0,0,0,0.6), 0 0 0 14px rgba(79,157,105,0.22); transform: scale(1.035) rotate(-0.6deg); }
    55%  { transform: scale(1.02) rotate(0.6deg); }
    100% { box-shadow: 0 18px 40px -18px rgba(0,0,0,0.6), 0 0 0 0 rgba(79,157,105,0); transform: scale(1) rotate(0deg); }
  }
  .card.card-correct-pulse{
    animation: cardCorrectPulse 0.7s ease-out;
  }
  @keyframes cardWrongShake{
    0%   { box-shadow: 0 18px 40px -18px rgba(0,0,0,0.6), 0 0 0 0 rgba(210,96,74,0.55); transform: translateX(0); }
    20%  { transform: translateX(-8px) rotate(-1deg); }
    40%  { transform: translateX(7px) rotate(1deg); box-shadow: 0 18px 40px -18px rgba(0,0,0,0.6), 0 0 0 10px rgba(210,96,74,0.16); }
    60%  { transform: translateX(-5px) rotate(-0.6deg); }
    80%  { transform: translateX(3px) rotate(0.3deg); }
    100% { transform: translateX(0) rotate(0deg); box-shadow: 0 18px 40px -18px rgba(0,0,0,0.6), 0 0 0 0 rgba(210,96,74,0); }
  }
  .card.card-wrong-shake{
    animation: cardWrongShake 0.5s ease-out;
  }
  .confetti-piece{
    position:absolute;
    left: 50%;
    top: 45%;
    pointer-events:none;
    z-index: 5;
    animation-name: confettiFly;
    animation-timing-function: ease-out;
    animation-fill-mode: forwards;
  }
  @keyframes confettiFly{
    0%   { transform: translate(-50%,-50%) translate(0,0) rotate(0deg) scale(0.6); opacity: 1; }
    15%  { transform: translate(-50%,-50%) translate(calc(var(--dx) * 0.2), calc(var(--dy) * 0.2)) rotate(calc(var(--rot) * 0.2)) scale(1.1); opacity: 1; }
    100% { transform: translate(-50%,-50%) translate(var(--dx), var(--dy)) rotate(var(--rot)) scale(0.8); opacity: 0; }
  }
  .card .pos{
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform:uppercase;
    color: var(--gold-dim);
    margin-bottom: 8px;
  }
  .card .prompt{
    font-family: 'Manrope', sans-serif;
    font-weight: 800;
    font-size: 32px;
    line-height:1.3;
    letter-spacing: 0.005em;
    word-break: break-word;
  }
  .card .prompt.jp{
    font-family:'IBM Plex Sans JP', sans-serif;
    font-size: 24px;
    font-weight:600;
  }

  .punch{
    display:flex;
    justify-content:center;
    gap: 10px;
    margin: 16px 0 4px;
  }
  .punch .dot{
    width: 13px;
    height:13px;
    border-radius:50%;
    border: 1.5px solid var(--gold-dim);
    background: transparent;
    transition: all .25s ease;
  }
  .punch .dot.filled{
    background: var(--gold);
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201,150,59,0.18);
  }

  .round-indicator{
    text-align:center;
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.03em;
    margin-bottom: 14px;
  }

  .score-meter{
    display:flex;
    align-items:center;
    gap: 10px;
    margin: 16px 0 4px;
  }
  .score-meter .score-track{
    flex:1;
    height: 10px;
    background: var(--ink-soft);
    border: 1px solid #2A3140;
    border-radius: 999px;
    overflow:hidden;
  }
  .score-meter .score-fill{
    height:100%;
    background: linear-gradient(90deg, var(--gold-dim), var(--gold));
    border-radius: 999px;
    transition: width .35s ease;
  }
  .score-meter .score-label{
    font-size: 12px;
    font-weight:700;
    color: var(--gold);
    min-width: 58px;
    text-align:right;
    white-space:nowrap;
  }
  .score-meter .score-label.negative{
    color: var(--coral);
  }
  .score-meter-sm{
    margin: 0;
    gap: 6px;
  }
  .score-meter-sm .score-track{
    height: 6px;
  }
  .score-meter-sm .score-label{
    font-size: 10px;
    min-width: 42px;
  }

  .round-summary-card{
    background: var(--paper);
    color: var(--text-on-paper);
    border-radius: 18px;
    padding: 40px 24px;
    text-align:center;
    box-shadow: 0 18px 40px -18px rgba(0,0,0,0.6);
  }
  .round-summary-score{
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 30px;
    margin-bottom: 8px;
  }
  .round-summary-points{
    font-family: 'Manrope', sans-serif;
    font-weight: 800;
    font-size: 22px;
    color: var(--green);
    margin-bottom: 14px;
  }
  .round-summary-points.negative{
    color: var(--coral);
  }
  .round-summary-comment{
    font-size: 14px;
    color: var(--gold-dim);
  }
  .round-next-btn{
    display:block;
    width:100%;
    background: var(--gold);
    color: var(--ink);
    border:none;
    font-family: inherit;
    font-size: 15px;
    font-weight:700;
    padding: 14px;
    border-radius: 12px;
    cursor:pointer;
    margin-top: 24px;
  }
  .round-history-btn{
    display:block;
    width:100%;
    background: transparent;
    color: var(--gold);
    border: 1px solid var(--gold-dim);
    font-family: inherit;
    font-size: 13px;
    font-weight:600;
    padding: 11px;
    border-radius: 12px;
    cursor:pointer;
    margin-top: 10px;
  }

  .chart-scroll{
    overflow-x: auto;
    overflow-y: hidden;
    background: var(--ink-soft);
    border: 1px solid #2A3140;
    border-radius: 12px;
    padding: 10px 6px 4px;
    margin-bottom: 10px;
  }
  .chart-scroll svg{
    display:block;
  }
  .chart-axis-label{
    font-size: 9px;
    fill: var(--text-muted);
    font-family: 'IBM Plex Sans JP', sans-serif;
  }
  .chart-axis-label-left{
    fill: var(--text-muted);
  }
  .chart-legend{
    display:flex;
    gap: 14px;
    flex-wrap:wrap;
    justify-content:center;
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 18px;
  }
  .chart-legend .legend-dot{
    display:inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    margin-right: 4px;
    vertical-align: middle;
  }
  .chart-legend .heat-gradient{
    background: linear-gradient(90deg, var(--coral), var(--green));
    border-radius: 2px;
  }

  .next-btn-wrap{
    min-height: 0;
  }
  .next-btn-wrap:empty{
    margin: 0;
  }
  @keyframes nextBtnIn{
    0%   { opacity: 0; transform: translateY(6px) scale(0.97); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  .next-question-btn{
    display:block;
    width:100%;
    background: var(--gold);
    color: var(--ink);
    border:none;
    font-family: inherit;
    font-size: 15px;
    font-weight:800;
    padding: 14px;
    border-radius: 12px;
    cursor:pointer;
    margin: 14px 0 4px;
    animation: nextBtnIn 0.25s ease-out;
  }
  .next-question-btn:active{
    transform: scale(0.98);
  }

  .choices{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .choices.choices-compact{
    gap: 6px;
  }
  .choice{
    background: var(--ink-soft);
    border: 1px solid #2A3140;
    color: var(--text-on-ink);
    font-family: inherit;
    font-size: 14px;
    line-height:1.4;
    padding: 14px 10px;
    border-radius: 12px;
    cursor:pointer;
    transition: all .15s ease;
    text-align:center;
  }
  .choice:active{ transform: scale(0.97); }
  .choice-compact{
    padding: 9px 8px;
    font-size: 12.5px;
    border-radius: 9px;
  }
  .choice-en{
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.005em;
  }
  .choice-en.choice-compact{
    font-size: 13px;
  }
  .choice.correct{
    background: rgba(79,157,105,0.18);
    border-color: var(--green);
    color: #A9E4BC;
  }
  .choice.wrong{
    background: rgba(210,96,74,0.18);
    border-color: var(--coral);
    color: #F1AE9E;
  }
  .choice[disabled]{ cursor:default; }

  .toast{
    text-align:center;
    font-size: 13px;
    color: var(--gold);
    font-weight:600;
    min-height: 34px;
    margin-top: 2px;
    margin-bottom: 12px;
    letter-spacing: 0.02em;
    line-height: 1.35;
    transition: font-size .15s ease;
  }
  @keyframes toastPop{
    0%   { transform: translateY(4px) scale(0.8) rotate(-1.5deg); opacity: 0; }
    40%  { transform: translateY(-3px) scale(1.22) rotate(1.5deg); opacity: 1; }
    65%  { transform: translateY(0) scale(0.96) rotate(-0.7deg); }
    100% { transform: translateY(0) scale(1) rotate(0deg); opacity: 1; }
  }
  .toast.toast-correct{
    color: var(--green);
    font-size: 22px;
    font-weight:800;
    animation: toastPop 0.5s cubic-bezier(.34,1.56,.64,1);
  }
  .toast.toast-correct.toast-master{
    font-size: 26px;
    color: var(--gold);
  }
  @keyframes toastShake{
    0%   { transform: translateX(0); opacity: 0; }
    20%  { transform: translateX(-6px); opacity: 1; }
    40%  { transform: translateX(5px); }
    60%  { transform: translateX(-4px); }
    80%  { transform: translateX(2px); }
    100% { transform: translateX(0); opacity: 1; }
  }
  .toast.toast-wrong{
    color: var(--coral);
    font-size: 17px;
    font-weight:700;
    animation: toastShake 0.4s ease-out;
  }

  .done{
    text-align:center;
    padding: 60px 20px;
  }
  .done .big{
    font-family:'Fraunces', serif;
    font-size: 26px;
    margin-bottom: 10px;
  }
  .done p{
    color: var(--text-muted);
    font-size: 14px;
    line-height:1.6;
  }

  footer{
    text-align:center;
    margin-top: 28px;
  }
  footer button{
    background:none;
    border:none;
    color: var(--text-muted);
    font-size: 12px;
    font-family:inherit;
    text-decoration: underline;
    cursor:pointer;
  }
  footer button:hover{ color: var(--coral); }

  .loading{
    text-align:center;
    padding: 80px 20px;
    color: var(--text-muted);
    font-size: 14px;
  }
</style>
</head>
<body>
<div class="app" id="app">
  <div class="loading">読み込み中…</div>
</div>

<script>
const WORDS = [
  {w:"abandon", pos:"動詞", jp:"〜を捨て去る、放棄する", level:"2級"},
  {w:"abolish", pos:"動詞", jp:"（法律や制度などを）廃止する", level:"2級"},
  {w:"absorb", pos:"動詞", jp:"〜を吸収する、理解する", level:"2級"},
  {w:"abstract", pos:"形容詞", jp:"抽象的な、難解な", level:"2級"},
  {w:"abundant", pos:"形容詞", jp:"豊富な、大量の", level:"2級"},
  {w:"academic", pos:"形容詞", jp:"学問の、学術的な", level:"2級"},
  {w:"accelerate", pos:"動詞", jp:"〜を加速させる、促進する", level:"2級"},
  {w:"accessible", pos:"形容詞", jp:"接近できる、利用しやすい", level:"2級"},
  {w:"accommodate", pos:"動詞", jp:"〜を収容する、対応する", level:"2級"},
  {w:"accompany", pos:"動詞", jp:"〜に同行する、伴う", level:"2級"},
  {w:"accomplish", pos:"動詞", jp:"〜を成し遂げる、達成する", level:"2級"},
  {w:"accumulate", pos:"動詞", jp:"〜を蓄積する、溜まる", level:"2級"},
  {w:"accurate", pos:"形容詞", jp:"正確な、精密な", level:"2級"},
  {w:"accuse", pos:"動詞", jp:"〜を非難する、告発する", level:"2級"},
  {w:"acknowledge", pos:"動詞", jp:"〜を認める、承認する", level:"2級"},
  {w:"acquire", pos:"動詞", jp:"〜を習得する、獲得する", level:"2級"},
  {w:"adapt", pos:"動詞", jp:"〜に適応する、順応する", level:"2級"},
  {w:"adequate", pos:"形容詞", jp:"十分な、適切な", level:"2級"},
  {w:"adjust", pos:"動詞", jp:"〜を調整する、調節する", level:"2級"},
  {w:"administer", pos:"動詞", jp:"〜を管理する、投与する", level:"2級"},
  {w:"admire", pos:"動詞", jp:"〜に感心する、称賛する", level:"2級"},
  {w:"adopt", pos:"動詞", jp:"〜を採用する、養子にする", level:"2級"},
  {w:"advocate", pos:"動詞", jp:"〜を主張する、支持する", level:"2級"},
  {w:"affect", pos:"動詞", jp:"〜に影響を与える", level:"2級"},
  {w:"affordable", pos:"形容詞", jp:"手頃な価格の", level:"2級"},
  {w:"aggressive", pos:"形容詞", jp:"攻撃的な、積極的な", level:"2級"},
  {w:"agricultural", pos:"形容詞", jp:"農業の、農学の", level:"2級"},
