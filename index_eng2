const app = document.getElementById("app");

function migrateEntry(entry){
  if(entry && entry.score === undefined){
    const score = entry.mastered ? GRADUATION_SCORE : Math.min(80, (entry.streak || 0) * 20);
    return { score, graduated: !!entry.mastered };
  }
  return entry;
}

function ensureProgress(id){
  if(!progress[id]) progress[id] = { score: 0, graduated: false };
  else progress[id] = migrateEntry(progress[id]);
  return progress[id];
}

function ensureQuoteProgress(id){
  if(!quoteProgress[id]) quoteProgress[id] = { score: 0, graduated: false };
  else quoteProgress[id] = migrateEntry(quoteProgress[id]);
  return quoteProgress[id];
}

async function loadProgress(){
  try{
    const res = await window.storage.get(STORAGE_KEY, false);
    if(res && res.value){
      const data = JSON.parse(res.value);
      progress = data.progress || {};
      quoteProgress = data.quoteProgress || {};
      roundHistory = Array.isArray(data.roundHistory) ? data.roundHistory : [];
      quoteRoundHistory = Array.isArray(data.quoteRoundHistory) ? data.quoteRoundHistory : [];
      if(data.settings){
        mode = data.settings.mode || mode;
        levelFilter = data.settings.levelFilter || levelFilter;
        typeFilter = data.settings.typeFilter || typeFilter;
        choiceCount = [4,8,10,20].includes(data.settings.choiceCount) ? data.settings.choiceCount : choiceCount;
        appSection = data.settings.appSection || appSection;
        quoteMode = data.settings.quoteMode || quoteMode;
        quoteCategoryFilter = data.settings.quoteCategoryFilter || quoteCategoryFilter;
      }
    }
  }catch(e){
    // key doesn't exist yet, or storage unavailable — start fresh
    progress = {};
    quoteProgress = {};
    roundHistory = [];
    quoteRoundHistory = [];
  }
  WORDS.forEach(w => ensureProgress(w.id));
  QUOTES.forEach(q => ensureQuoteProgress(q.id));
}

async function saveProgress(){
  try{
    const payload = {
      progress, quoteProgress, roundHistory, quoteRoundHistory,
      settings: { mode, levelFilter, typeFilter, choiceCount, appSection, quoteMode, quoteCategoryFilter }
    };
    await window.storage.set(STORAGE_KEY, JSON.stringify(payload), false);
  }catch(e){
    storageOK = false;
  }
}

function pushRoundHistory(historyArr, state){
  historyArr.push({ correct: state.correct, total: ROUND_SIZE, points: state.points, ts: Date.now() });
  while(historyArr.length > MAX_ROUND_HISTORY) historyArr.shift();
}

function scopedWords(){
  return WORDS.filter(w => {
    const kind = w.pos === "熟語" ? "熟語" : "単語";
    return (levelFilter === "all" || w.level === levelFilter) &&
           (typeFilter === "all" || kind === typeFilter);
  });
}

function activeWords(){
  return scopedWords().filter(w => !ensureProgress(w.id).graduated);
}

function weightedPick(pool, getScore){
  if(pool.length === 0) return null;
  if(pool.length === 1) return pool[0];
  const weights = pool.map(item => {
    const s = Math.max(SCORE_MIN, Math.min(99, getScore(item)));
    return Math.max(1, 100 - s);
  });
  const total = weights.reduce((a,b) => a+b, 0);
  let r = Math.random() * total;
  for(let i = 0; i < pool.length; i++){
    r -= weights[i];
    if(r <= 0) return pool[i];
  }
  return pool[pool.length - 1];
}

function pickNextWord(){
  const pool = activeWords();
  if(pool.length === 0) return null;
  let choices = pool;
  if(pool.length > 1 && currentWord){
    const filtered = pool.filter(w => w.id !== currentWord.id);
    if(filtered.length > 0) choices = filtered;
  }
  return weightedPick(choices, w => ensureProgress(w.id).score);
}

function buildChoices(word){
  const correct = mode === "e2j" ? word.jp : word.w;
  const needed = choiceCount - 1;
  let pool = scopedWords().filter(w => w.id !== word.id);
  if(pool.length < needed) pool = WORDS.filter(w => w.id !== word.id); // fall back if scope too narrow

  const shuffled = [...pool].sort(() => Math.random() - 0.5);
  const seenText = new Set([correct]);
  const distractors = [];
  for(const w of shuffled){
    if(distractors.length >= needed) break;
    const text = mode === "e2j" ? w.jp : w.w;
    if(seenText.has(text)) continue;
    seenText.add(text);
    distractors.push(text);
  }
  const options = [...distractors, correct].sort(() => Math.random() - 0.5);
  return options;
}

function nextQuestion(){
  locked = false;
  currentWord = pickNextWord();
  if(currentWord){
    currentChoices = buildChoices(currentWord);
  }
  questionStartTime = Date.now();
  render();
}

function scopedQuotes(){
  return QUOTES.filter(q => quoteCategoryFilter === "all" || q.category === quoteCategoryFilter);
}

function activeQuotes(){
  return scopedQuotes().filter(q => !ensureQuoteProgress(q.id).graduated);
}

function pickNextQuote(){
  const pool = activeQuotes();
  if(pool.length === 0) return null;
  let choices = pool;
  if(pool.length > 1 && currentQuote){
    const filtered = pool.filter(q => q.id !== currentQuote.id);
    if(filtered.length > 0) choices = filtered;
  }
  return weightedPick(choices, q => ensureQuoteProgress(q.id).score);
}

function buildQuoteChoices(quote){
  const correct = quoteMode === "q2a" ? quote.author : quote.jp;
  const needed = choiceCount - 1;
  let pool = scopedQuotes().filter(q => q.id !== quote.id);
  if(pool.length < needed) pool = QUOTES.filter(q => q.id !== quote.id);

  const shuffled = [...pool].sort(() => Math.random() - 0.5);
  const seenText = new Set([correct]);
  const distractors = [];
  for(const q of shuffled){
    if(distractors.length >= needed) break;
    const text = quoteMode === "q2a" ? q.author : q.jp;
    if(seenText.has(text)) continue;
    seenText.add(text);
    distractors.push(text);
  }
  const options = [...distractors, correct].sort(() => Math.random() - 0.5);
  return options;
}

function nextQuoteQuestion(){
  quoteLocked = false;
  currentQuote = pickNextQuote();
  if(currentQuote){
    currentQuoteChoices = buildQuoteChoices(currentQuote);
  }
  quoteQuestionStartTime = Date.now();
  render();
}

