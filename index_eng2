const QUOTES = [
  {en:"The only way to do great work is to love what you do.", jp:"素晴らしい仕事をする唯一の方法は、自分のやっていることを愛することだ。", author:"Steve Jobs", category:"Success & Achievement"},
  {en:"Success is not final, failure is not fatal: it is the courage to continue that counts.", jp:"成功は決定的ではなく、失敗は致命的ではない。大切なのは続ける勇気だ。", author:"Winston Churchill", category:"Success & Achievement"},
  {en:"Opportunities don't happen. You create them.", jp:"機会は偶然に訪れるのではない。自分で作り出すものだ。", author:"Chris Grosser", category:"Success & Achievement"},
  {en:"Don't watch the clock; do what it does. Keep going.", jp:"時計を見るな。時計と同じように進み続けよ。", author:"Sam Levenson", category:"Success & Achievement"},
  {en:"The secret of getting ahead is getting started.", jp:"一歩先を行く秘密は、まず始めることだ。", author:"Mark Twain", category:"Success & Achievement"},
  {en:"Action is the foundational key to all success.", jp:"行動こそがすべての成功の基礎となる鍵である。", author:"Pablo Picasso", category:"Success & Achievement"},
  {en:"Success usually comes to those who are too busy to be looking for it.", jp:"成功は通常、それを探す暇もないほど忙しい人に訪れる。", author:"Henry David Thoreau", category:"Success & Achievement"},
  {en:"It always seems impossible until it's done.", jp:"何事も達成するまでは不可能に思えるものだ。", author:"Nelson Mandela", category:"Success & Achievement"},
  {en:"Try not to become a man of success, but rather try to become a man of value.", jp:"成功者になろうとするのではなく、価値ある人間になろうとしなさい。", author:"Albert Einstein", category:"Success & Achievement"},
  {en:"Don't be afraid to give up the good to go for the great.", jp:"偉大なものを目指すために、良いものを諦めることを恐れてはならない。", author:"John D. Rockefeller", category:"Success & Achievement"},
  {en:"I find that the harder I work, the more luck I seem to have.", jp:"熱心に働けば働くほど、より多くの幸運が舞い込んでくるように思える。", author:"Thomas Jefferson", category:"Success & Achievement"},
  {en:"Success is walking from failure to failure with no loss of enthusiasm.", jp:"成功とは、情熱を失わずに失敗から失敗へと歩み続けることだ。", author:"Winston Churchill", category:"Success & Achievement"},
  {en:"Small deeds done are better than great deeds planned.", jp:"計画された偉大な行為よりも、実行された小さな行為の方が価値がある。", author:"Peter Marshall", category:"Success & Achievement"},
  {en:"The starting point of all achievement is desire.", jp:"すべての成就の出発点は、願望である。", author:"Napoleon Hill", category:"Success & Achievement"},
  {en:"There are no secrets to success. It is the result of preparation, hard work, and learning from failure.", jp:"成功に秘密はない。準備、努力、そして失敗から学ぶことの結果なのだ。", author:"Colin Powell", category:"Success & Achievement"},
  {en:"If you really look closely, most overnight successes took a long time.", jp:"本当に熟考してみれば、一夜にして成功したように見えるものも長い時間がかかっている。", author:"Steve Jobs", category:"Success & Achievement"},
  {en:"Defensiveness is the enemy of change.", jp:"自己弁護は変化の敵である。", author:"Brené Brown", category:"Success & Achievement"},
  {en:"Great things are done by a series of small things brought together.", jp:"偉大なことは、小さなことの積み重ねによって達成される。", author:"Vincent van Gogh", category:"Success & Achievement"},
  {en:"The way to get started is to quit talking and begin doing.", jp:"始めるための方法は、口を開くのをやめて手を動かすことだ。", author:"Walt Disney", category:"Success & Achievement"},
  {en:"Success is how high you bounce when you hit bottom.", jp:"成功とは、どん底に落ちたときにどれだけ高く跳ね返れるかだ。", author:"George S. Patton", category:"Success & Achievement"},
  {en:"Patience, persistence and perspiration make an unbeatable combination for success.", jp:"忍耐、粘り強さ、そして汗。これらが成功のための無敵の組み合わせとなる。", author:"Napoleon Hill", category:"Success & Achievement"},
  {en:"Rule No.1: Never lose money. Rule No.2: Never forget rule No.1.", jp:"ルール1：決して損をするな。ルール2：ルール1を絶対に忘れるな。", author:"Warren Buffett", category:"Success & Achievement"},
  {en:"Formulate and stamp indelibly on your mind a mental picture of yourself as succeeding.", jp:"自分が成功している姿を心に深く刻み込みなさい。", author:"Norman Vincent Peale", category:"Success & Achievement"},
  {en:"Success seems to be connected with action. Successful people keep moving.", jp:"成功は行動と結びついているようだ。成功する人は動き続ける。", author:"Conrad Hilton", category:"Success & Achievement"},
  {en:"The difference between a successful person and others is not a lack of strength, not a lack of knowledge, but rather a lack of will.", jp:"成功者とそうでない者の違いは、力や知識の欠如ではなく、意志の欠如である。", author:"Vince Lombardi", category:"Success & Achievement"},
  {en:"It is during our darkest moments that we must focus to see the light.", jp:"私たちが光を見ることに集中しなければならないのは、最も暗い瞬間においてである。", author:"Aristotle", category:"Perseverance & Courage"},
  {en:"You must do the things you think you cannot do.", jp:"自分にはできないと思うことこそ、やらなければならない。", author:"Eleanor Roosevelt", category:"Perseverance & Courage"},
  {en:"Courage is grace under pressure.", jp:"勇気とは、プレッシャーにさらされた際のエレガンス（気品）である。", author:"Ernest Hemingway", category:"Perseverance & Courage"},
  {en:"Never give up on a dream just because of the time it will take to accomplish it.", jp:"達成に時間がかかるという理由だけで、夢を諦めてはならない。", author:"Earl Nightingale", category:"Perseverance & Courage"},
  {en:"Everything you've ever wanted is on the other side of fear.", jp:"あなたがずっと望んでいたものはすべて、恐怖の向こう側にある。", author:"George Addair", category:"Perseverance & Courage"},
  {en:"Hardships often prepare ordinary people for an extraordinary destiny.", jp:"試練は往々にして、普通の人々を並外れた運命へと準備させる。", author:"C.S. Lewis", category:"Perseverance & Courage"},
  {en:"Fall seven times and stand up eight.", jp:"七転び八起き。", author:"Japanese Proverb", category:"Perseverance & Courage"},
  {en:"Believe you can and you're halfway there.", jp:"できると信じれば、すでに道半ばまで来ている。", author:"Theodore Roosevelt", category:"Perseverance & Courage"},
  {en:"Courage doesn't always roar. Sometimes courage is the quiet voice at the end of the day saying, 'I will try again tomorrow.'", jp:"勇気とは必ずしも叫び声をあげるものではない。時には『明日またやってみよう』という一日の終わりの静かな声なのだ。", author:"Mary Anne Radmacher", category:"Perseverance & Courage"},
  {en:"Our greatest glory is not in never falling, but in rising every time we fall.", jp:"最大の栄光は一度も倒れないことではなく、倒れるたびに起き上がることにある。", author:"Confucius", category:"Perseverance & Courage"},
  {en:"He who is not courageous enough to take risks will accomplish nothing in life.", jp:"リスクを冒す勇気のない者は、人生で何も達成することはできない。", author:"Muhammad Ali", category:"Perseverance & Courage"},
  {en:"Tough times never last, but tough people do.", jp:"困難な時代は続かないが、タフな人々は生き残る。", author:"Robert H. Schuller", category:"Perseverance & Courage"},
  {en:"Doubt kills more dreams than failure ever will.", jp:"疑いは、失敗よりも多くの夢を殺す。", author:"Suzy Kassem", category:"Perseverance & Courage"},
  {en:"A ship in harbor is safe, but that is not what ships are built for.", jp:"港にいる船は安全だが、それは船が造られた目的ではない。", author:"John A. Shedd", category:"Perseverance & Courage"},
  {en:"You cannot swim for new horizons until you have courage to lose sight of the shore.", jp:"岸が見えなくなるほどの勇気を持たなければ、新しい水平線へ泳ぎ出すことはできない。", author:"André Gide", category:"Perseverance & Courage"},
  {en:"When you reach the end of your rope, tie a knot in it and hang on.", jp:"ロープの端まで行き着いたら、結び目を作ってつかまり続けなさい。", author:"Franklin D. Roosevelt", category:"Perseverance & Courage"},
  {en:"Keep your face always toward the sunshine—and shadows will fall behind you.", jp:"常に太陽の方を向いていなさい。そうすれば影はあなたの後ろに落ちる。", author:"Walt Whitman", category:"Perseverance & Courage"},
  {en:"Do one thing every day that scares you.", jp:"毎日、自分が恐怖を感じることを一つやりなさい。", author:"Eleanor Roosevelt", category:"Perseverance & Courage"},
  {en:"The man who moves a mountain begins by carrying away small stones.", jp:"山を動かす者は、まず小さな石を運び出すことから始める。", author:"Confucius", category:"Perseverance & Courage"},
  {en:"Never let the fear of striking out keep you from playing the game.", jp:"三振の恐怖に、試合でプレイすることを邪魔させてはならない。", author:"Babe Ruth", category:"Perseverance & Courage"},
  {en:"Only those who dare to fail greatly can ever achieve greatly.", jp:"大失敗する覚悟のある者だけが、大成功を収めることができる。", author:"Robert F. Kennedy", category:"Perseverance & Courage"},
  {en:"Be brave enough to start a conversation that matters.", jp:"重要な対話を始めるだけの勇気を持ちなさい。", author:"Dau Voire", category:"Perseverance & Courage"},
  {en:"The oak fought the wind and was broken, the willow bent when it must and survived.", jp:"樫の木は風と戦って折れ、柳の木は必要なときにしなって生き残った。", author:"Robert Jordan", category:"Perseverance & Courage"},
  {en:"Strength does not come from winning. Your struggles develop your strengths.", jp:"強さは勝利から生まれるのではない。苦闘こそがあなたの強さを養うのだ。", author:"Arnold Schwarzenegger", category:"Perseverance & Courage"},
  {en:"Pain is inevitable. Suffering is optional.", jp:"痛みは避けられないが、苦しむかどうかは自分次第だ。", author:"Haruki Murakami", category:"Perseverance & Courage"},
  {en:"In the middle of difficulty lies opportunity.", jp:"困難のただ中に、機会が転がっている。", author:"Albert Einstein", category:"Life & Purpose"},
  {en:"Life is what happens when you're busy making other plans.", jp:"人生とは、他の計画を立てるのに忙しい時に起きる出来事のことだ。", author:"John Lennon", category:"Life & Purpose"},
  {en:"Your time is limited, so don't waste it living someone else's life.", jp:"あなたの時間は限られている。だから誰か他の人の人生を生きて無駄にしてはいけない。", author:"Steve Jobs", category:"Life & Purpose"},
  {en:"Life isn't about finding yourself. Life is about creating yourself.", jp:"人生とは自分を探すことではない。自分を創り上げることだ。", author:"George Bernard Shaw", category:"Life & Purpose"},
  {en:"In three words I can sum up everything I've learned about life: it goes on.", jp:"人生について学んだすべてを3つの言葉で要約できる。それは『道は続く』ということだ。", author:"Robert Frost", category:"Life & Purpose"},
  {en:"To live is the rarest thing in the world. Most people exist, that is all.", jp:"生きるということは、世界で最も珍しいことだ。大半の人々はただ存在しているだけである。", author:"Oscar Wilde", category:"Life & Purpose"},
  {en:"Live as if you were to die tomorrow. Learn as if you were to live forever.", jp:"明日死ぬかのように生きよ。永遠に生きるかのように学べ。", author:"Mahatma Gandhi", category:"Life & Purpose"},
  {en:"Life is either a daring adventure or nothing at all.", jp:"人生とは、思い切った冒険か、さもなければ何もないかのどちらかだ。", author:"Helen Keller", category:"Life & Purpose"},
  {en:"Good judgment comes from experience, and a lot of that comes from bad judgment.", jp:"正しい判断力は経験から生まれ、その経験の多くは愚かな判断から生まれる。", author:"Will Rogers", category:"Life & Purpose"},
  {en:"The purpose of our lives is to be happy.", jp:"私たちの人生の目的は、幸せになることである。", author:"Dalai Lama", category:"Life & Purpose"},
  {en:"Get busy living or get busy dying.", jp:"必死に生きるか、必死に死ぬかだ。", author:"Stephen King", category:"Life & Purpose"},
  {en:"You only live once, but if you do it right, once is enough.", jp:"人生は一度きりだが、正しく生きれば一度で十分だ。", author:"Mae West", category:"Life & Purpose"},
  {en:"The unexamined life is not worth living.", jp:"吟味されない人生に、生きる価値はない。", author:"Socrates", category:"Life & Purpose"},
  {en:"Turn your wounds into wisdom.", jp:"あなたの傷を知恵に変えなさい。", author:"Oprah Winfrey", category:"Life & Purpose"},
  {en:"Not how long, but how well you have lived is the main thing.", jp:"大切なのは、どれだけ長く生きたかではなく、どれだけ良く生きたかだ。", author:"Seneca", category:"Life & Purpose"},
  {en:"Life is 10% what happens to you and 90% how you react to it.", jp:"人生の10%は起こる出来事であり、90%はそれにどう反応するかだ。", author:"Charles R. Swindoll", category:"Life & Purpose"},
  {en:"Life is short, and it is up to you to make it sweet.", jp:"人生は短い、それを素晴らしいものにするかどうかは自分次第だ。", author:"Sarah Louise Delany", category:"Life & Purpose"},
  {en:"May you live all the days of your life.", jp:"あなたの人生のすべての日々を、生き切らんことを。", author:"Jonathan Swift", category:"Life & Purpose"},
  {en:"The biggest adventure you can take is to live the life of your dreams.", jp:"あなたが乗り出すことのできる最大の冒険は、自分の夢の人生を生きることだ。", author:"Oprah Winfrey", category:"Life & Purpose"},
  {en:"Life is a journey that must be traveled no matter how bad the roads and accommodations.", jp:"人生とは、どれほど道や宿が悪くても旅しなければならない旅路である。", author:"Oliver Goldsmith", category:"Life & Purpose"},
  {en:"Do not dwell in the past, do not dream of the future, concentrate the mind on the present moment.", jp:"過去に囚われず、未来を夢見ず、ただ現在の瞬間に心を集中させなさい。", author:"Buddha", category:"Life & Purpose"},
  {en:"In the end, it's not the years in your life that count. It's the life in your years.", jp:"結局のところ、大切なのは生きている年数ではない。その年数の中にどれだけの『生』があったかだ。", author:"Abraham Lincoln", category:"Life & Purpose"},
  {en:"To be yourself in a world that is constantly trying to make you something else is the greatest accomplishment.", jp:"常にあなたを何か別のものにしようとする世界の中で、自分自身であり続けることは最大の偉業だ。", author:"Ralph Waldo Emerson", category:"Life & Purpose"},
  {en:"Life shrinks or expands in proportion to one's courage.", jp:"人生は、その人の勇気に比例して縮小もし拡大もする。", author:"Anaïs Nin", category:"Life & Purpose"},
  {en:"Life is really simple, but we insist on making it complicated.", jp:"人生は実にシンプルなのだが、私たちがそれを複雑にすることに固執しているのだ。", author:"Confucius", category:"Life & Purpose"},
  {en:"Change your thoughts and you change your world.", jp:"思考を変えれば、世界が変わる。", author:"Norman Vincent Peale", category:"Growth & Mindset"},
  {en:"The mind is everything. What you think you become.", jp:"心がすべてである。あなたは自分が考えた通りの人間になる。", author:"Buddha", category:"Growth & Mindset"},
  {en:"An investment in knowledge pays the best interest.", jp:"知識への投資は、常に最高の金利を生み出す。", author:"Benjamin Franklin", category:"Growth & Mindset"},
  {en:"Education is the most powerful weapon which you can use to change the world.", jp:"教育とは、世界を変えるために使用できる最も強力な武器である。", author:"Nelson Mandela", category:"Growth & Mindset"},
  {en:"The more that you read, the more things you will know. The more that you learn, the more places you'll go.", jp:"読めば読むほど知るようになり、学べば学ぶほど様々な場所へ行けるようになる。", author:"Dr. Seuss", category:"Growth & Mindset"},
  {en:"Yesterday I was clever, so I wanted to change the world. Today I am wise, so I am changing myself.", jp:"昨日の私は賢かったので世界を変えたいと思った。今日の私は知恵があるので自分自身を変えている。", author:"Rumi", category:"Growth & Mindset"},
  {en:"The capacity to learn is a gift; the ability to learn is a skill; the willingness to learn is a choice.", jp:"学ぶ能力は贈り物であり、学ぶ技術はスキルであり、学ぼうとする意志は選択である。", author:"Brian Herbert", category:"Growth & Mindset"},
  {en:"Growth begins at the end of your comfort zone.", jp:"成長はコンフォートゾーン（快適な領域）を脱けた先から始まる。", author:"Roy T. Bennett", category:"Growth & Mindset"},
  {en:"Continuous learning is the minimum requirement for success in any field.", jp:"継続的な学習は、あらゆる分野で成功するための最低条件である。", author:"Brian Tracy", category:"Growth & Mindset"},
  {en:"If you are not willing to learn, no one can help you. If you are determined to learn, no one can stop you.", jp:"学ぼうとしないなら誰にも助けられない。学ぼうと決意しているなら誰にも止められない。", author:"Zig Ziglar", category:"Growth & Mindset"},
  {en:"It is not the strongest of the species that survives, nor the most intelligent, but the one most responsive to change.", jp:"生き残る種とは、最も強いものでも最も賢いものでもなく、変化に最も適応できるものである。", author:"Charles Darwin", category:"Growth & Mindset"},
  {en:"Don't judge each day by the harvest you reap but by the seeds that you plant.", jp:"収穫した果実によって日々を判断するのではなく、植えた種によって判断しなさい。", author:"Robert Louis Stevenson", category:"Growth & Mindset"},
  {en:"Wisdom begins in wonder.", jp:"知恵は好奇心（驚嘆）から始まる。", author:"Socrates", category:"Growth & Mindset"},
  {en:"You don't have to be great to start, but you have to start to be great.", jp:"始めるために素晴らしくある必要はないが、素晴らしくなるためには始めなければならない。", author:"Zig Ziglar", category:"Growth & Mindset"},
  {en:"Mistakes are the portals of discovery.", jp:"過ちとは、発見への入り口である。", author:"James Joyce", category:"Growth & Mindset"},
  {en:"The only true wisdom is in knowing you know nothing.", jp:"唯一の真の知恵とは、自分自身が何も知らないと知ることだ。", author:"Socrates", category:"Growth & Mindset"},
  {en:"Be curious, not judgmental.", jp:"批判的になるのではなく、好奇心を持ちなさい。", author:"Walt Whitman", category:"Growth & Mindset"},
  {en:"Tell me and I forget. Teach me and I remember. Involve me and I learn.", jp:"言われたことは忘れる。教えられたことは覚える。関与させられたことは学ぶ。", author:"Benjamin Franklin", category:"Growth & Mindset"},
  {en:"Every expert was once a beginner.", jp:"どんな専門家も、かつては初心者だった。", author:"Helen Hayes", category:"Growth & Mindset"},
  {en:"Change is the end result of all true learning.", jp:"変化こそが、すべての真の学びの最終結果である。", author:"Leo Buscaglia", category:"Growth & Mindset"},
  {en:"Self-knowledge is the beginning of wisdom.", jp:"自己を知ることが、知恵の始まりである。", author:"Aristotle", category:"Growth & Mindset"},
  {en:"Those who cannot change their minds cannot change anything.", jp:"自分の心を変えることができない者は、何も変えることができない。", author:"George Bernard Shaw", category:"Growth & Mindset"},
  {en:"Learning never exhausts the mind.", jp:"学びが心を疲弊させることは決してない。", author:"Leonardo da Vinci", category:"Growth & Mindset"},
  {en:"Do not be embarrassed by your failures, learn from them and start again.", jp:"自分の失敗を恥じるな。そこから学び、再び始めなさい。", author:"Richard Branson", category:"Growth & Mindset"},
  {en:"Small daily improvements over time lead to stunning results.", jp:"時間をかけた日々の小さな改善が、驚くべき結果につながる。", author:"Robin Sharma", category:"Growth & Mindset"},
  {en:"The future belongs to those who believe in the beauty of their dreams.", jp:"未来は自分の夢の美しさを信じる者のものだ。", author:"Eleanor Roosevelt", category:"Vision & Dreams"},
  {en:"Dream big and dare to fail.", jp:"大きな夢を抱き、あえて失敗せよ。", author:"Norman Vaughan", category:"Vision & Dreams"},
  {en:"The best way to predict your future is to create it.", jp:"未来を予測する最良の方法は、それを自分で創ることだ。", author:"Peter Drucker", category:"Vision & Dreams"},
  {en:"All our dreams can come true, if we have the courage to pursue them.", jp:"追い求める勇気さえあれば、私たちの夢はすべて叶う。", author:"Walt Disney", category:"Vision & Dreams"},
  {en:"Hold fast to dreams, for if dreams die, life is a broken-winged bird that cannot fly.", jp:"夢を強く持ち続けよ。夢が死ねば、人生は飛べない翼の折れた鳥となる。", author:"Langston Hughes", category:"Vision & Dreams"},
  {en:"Aim for the moon. If you miss, you may hit a star.", jp:"月を目指しなさい。たとえ外れても、どこかの星に着陸できるかもしれない。", author:"W. Clement Stone", category:"Vision & Dreams"},
  {en:"A dream you dream alone is only a dream. A dream you dream together is reality.", jp:"一人の夢はただの夢。共に見る夢は現実となる。", author:"Yoko Ono", category:"Vision & Dreams"},
  {en:"A goal without a plan is just a wish.", jp:"計画のない目標は、ただの願い事に過ぎない。", author:"Antoine de Saint-Exupéry", category:"Vision & Dreams"},
  {en:"Never limit yourself because of others' limited imagination.", jp:"他人の限られた想像力のせいで、自分自身を制限してはならない。", author:"Mae Jemison", category:"Vision & Dreams"},
  {en:"You are never too old to set another goal or to dream a new dream.", jp:"新しい目標を立てたり、新しい夢を見るのに遅すぎるということはない。", author:"C.S. Lewis", category:"Vision & Dreams"},
  {en:"Keep your eyes on the stars, and your feet on the ground.", jp:"目は星に向け、足は地につけておきなさい。", author:"Theodore Roosevelt", category:"Vision & Dreams"},
  {en:"Believe in yourself and all that you are. Know that there is something inside you that is greater than any obstacle.", jp:"自分自身と自分のすべてを信じなさい。いかなる障害よりも偉大なものが自分の中に存在すると知りなさい。", author:"Christian D. Larson", category:"Vision & Dreams"},
  {en:"First, think. Second, dream. Third, believe. And finally, dare.", jp:"第一に考えよ。第二に夢見よ。第三に信じよ。そして最後に踏み出せ（挑め）。", author:"Walt Disney", category:"Vision & Dreams"},
  {en:"Go confidently in the direction of your dreams! Live the life you've imagined.", jp:"自分の夢の方向へ自信を持って進め！思い描いた人生を生きよ。", author:"Henry David Thoreau", category:"Vision & Dreams"},
  {en:"Look up at the stars and not down at your feet.", jp:"足元を見るのではなく、見上げて星を見なさい。", author:"Stephen Hawking", category:"Vision & Dreams"},
  {en:"The distance between dreams and reality is called action.", jp:"夢と現実の間にある距離、それを『行動』と呼ぶ。", author:"Unknown", category:"Vision & Dreams"},
  {en:"Doubt is a killer. You just have to know who you are and what you stand for.", jp:"疑いは毒だ。自分が何者であり、何のために立つのかを知るだけでよい。", author:"Jennifer Lopez", category:"Vision & Dreams"},
  {en:"To achieve great things, we must not only act, but also dream; not only plan, but also believe.", jp:"偉業を達成するには、行動するだけでなく夢も見なければならない。計画するだけでなく信じなければならない。", author:"Anatole France", category:"Vision & Dreams"},
  {en:"Without leaps of imagination or dreaming, we lose the excitement of possibilities.", jp:"想像力の飛躍や夢を見ることがなければ、可能性のときめきを失ってしまう。", author:"Gloria Steinem", category:"Vision & Dreams"},
  {en:"Every great dream begins with a dreamer.", jp:"すべての偉大な夢は、夢見る者から始まる。", author:"Harriet Tubman", category:"Vision & Dreams"},
  {en:"Shoot for the moon. Even if you miss, you'll land among the stars.", jp:"月を狙いなさい。失敗したとしても、星のただ中に降り立つだろう。", author:"Les Brown", category:"Vision & Dreams"},
  {en:"Don't let yesterday take up too much of today.", jp:"昨日という日に、今日という日の多くを奪わせてはならない。", author:"Will Rogers", category:"Vision & Dreams"},
  {en:"If you can dream it, you can do it.", jp:"夢見ることができるなら、それは実現できる。", author:"Walt Disney", category:"Vision & Dreams"},
  {en:"Vision without execution is just hallucination.", jp:"実行を伴わないビジョンは、ただの幻覚である。", author:"Henry Ford", category:"Vision & Dreams"},
  {en:"The only limit to our realization of tomorrow will be our doubts of today.", jp:"明日を実現する上での唯一の制限は、今日抱いている疑問（躊躇）である。", author:"Franklin D. Roosevelt", category:"Vision & Dreams"},
  {en:"Love the life you live. Live the life you love.", jp:"自分の生きる人生を愛せ。自分の愛する人生を生きろ。", author:"Bob Marley", category:"Love & Kindness"},
  {en:"Spread love everywhere you go. Let no one ever come to you without leaving happier.", jp:"行く先々で愛を振りまきなさい。あなたのもとを訪れた人が皆、より幸せになって去れるように。", author:"Mother Teresa", category:"Love & Kindness"},
  {en:"Where there is love there is life.", jp:"愛があるところに、生命がある。", author:"Mahatma Gandhi", category:"Love & Kindness"},
  {en:"No act of kindness, no matter how small, is ever wasted.", jp:"どんなに小さな親切も、決して無駄になることはない。", author:"Aesop", category:"Love & Kindness"},
  {en:"Darkness cannot drive out darkness; only light can do that. Hate cannot drive out hate; only love can do that.", jp:"闇で闇を追い払うことはできない。光だけがそれを可能にする。憎しみで憎しみを追い払うことはできない。愛だけがそれを可能にする。", author:"Martin Luther King Jr.", category:"Love & Kindness"},
  {en:"The best and most beautiful things in the world cannot be seen or even touched - they must be felt with the heart.", jp:"世界で最も素晴らしく美しいものは、見ることも触れることもできない。心で感じなければならないのだ。", author:"Helen Keller", category:"Love & Kindness"},
  {en:"Be kind whenever possible. It is always possible.", jp:"可能な限り親切でありなさい。それは常に可能なのだから。", author:"Dalai Lama", category:"Love & Kindness"},
  {en:"Kindness is a language which the deaf can hear and the blind can see.", jp:"優しさとは、耳の聞こえない者が聴くことができ、目の見えない者が見ることができる言語である。", author:"Mark Twain", category:"Love & Kindness"},
  {en:"Love is composed of a single soul inhabiting two bodies.", jp:"愛とは、二つの身体に宿る一つの魂で構成されている。", author:"Aristotle", category:"Love & Kindness"},
  {en:"Being deeply loved by someone gives you strength, while loving someone deeply gives you courage.", jp:"誰かに深く愛されることは強さを与え、誰かを深く愛することは勇気を与える。", author:"Lao Tzu", category:"Love & Kindness"},
  {en:"The greatest healing therapy is friendship and love.", jp:"最大の癒やしのセラピーとは、友情と愛である。", author:"Hubert H. Humphrey", category:"Love & Kindness"},
  {en:"Treat people as if they were what they ought to be and you help them to become what they are capable of being.", jp:"人をそのあるべき姿であるかのように扱えば、その人がなり得る姿へと成長するのを助けることになる。", author:"Johann Wolfgang von Goethe", category:"Love & Kindness"},
  {en:"If you want to go fast, go alone. If you want to go far, go together.", jp:"早く行きたいなら一人で行け。遠くまで行きたいならみんなで行け。", author:"African Proverb", category:"Love & Kindness"},
  {en:"A warm smile is the universal language of kindness.", jp:"暖かい笑顔は、優しさの世界共通言語である。", author:"William Arthur Ward", category:"Love & Kindness"},
  {en:"We rise by lifting others.", jp:"他者を引き上げることによって、私たちは高く昇る。", author:"Robert Ingersoll", category:"Love & Kindness"},
  {en:"There is only one happiness in this life, to love and be loved.", jp:"この人生における唯一の幸せは、愛し、愛されることだ。", author:"George Sand", category:"Love & Kindness"},
  {en:"Give light and people will find the way.", jp:"光を与えよ、さすれば人々は自ら道を見出すだろう。", author:"Ella Baker", category:"Love & Kindness"},
  {en:"Peace begins with a smile.", jp:"平和は笑顔から始まります。", author:"Mother Teresa", category:"Love & Kindness"},
  {en:"Never look down on anybody unless you're helping them up.", jp:"手を貸して引き上げるとき以外に、人を下に見下げてはならない。", author:"Jesse Jackson", category:"Love & Kindness"},
  {en:"How wonderful it is that nobody need wait a single moment before starting to improve the world.", jp:"世界を良くするために一瞬たりとも待つ必要がないとは、なんと素晴らしいことだろう。", author:"Anne Frank", category:"Love & Kindness"},
  {en:"To love oneself is the beginning of a lifelong romance.", jp:"自分自身を愛することは、生涯にわたるロマンスの始まりである。", author:"Oscar Wilde", category:"Love & Kindness"},
  {en:"A loyal friend is worth ten thousand relatives.", jp:"忠実な友一人には、一万人の親族と同等の価値がある。", author:"Euripides", category:"Love & Kindness"},
  {en:"Forgiveness is the attribute of the strong.", jp:"許すことは、強き者の属性である。", author:"Mahatma Gandhi", category:"Love & Kindness"},
  {en:"When the power of love overcomes the love of power, the world will know peace.", jp:"愛の力が権力への愛を克服したとき、世界は平和を知るだろう。", author:"Jimi Hendrix", category:"Love & Kindness"},
  {en:"Life is partially what we make it, and partly what it is made by the friends we choose.", jp:"人生とは、自分が作る部分と、選んだ友によって作られる部分からなる。", author:"Tennessee Williams", category:"Love & Kindness"},
  {en:"There is always light, if only we're brave enough to see it.", jp:"見ようとする勇気さえあれば、光は常にそこにある。", author:"Amanda Gorman", category:"Happiness & Positivity"},
  {en:"Happiness is not something ready made. It comes from your own actions.", jp:"幸福はあらかじめ用意されたものではない。自分の行動から生まれるものだ。", author:"Dalai Lama", category:"Happiness & Positivity"},
  {en:"For every minute you are angry you lose sixty seconds of happiness.", jp:"怒りを感じている1分ごとに、60秒の幸福を失っているのだ。", author:"Ralph Waldo Emerson", category:"Happiness & Positivity"},
  {en:"The most wasted of all days is one without laughter.", jp:"最も無駄にされた日とは、笑いのなかった日である。", author:"E.E. Cummings", category:"Happiness & Positivity"},
  {en:"Happiness depends upon ourselves.", jp:"幸福かどうかは自分次第である。", author:"Aristotle", category:"Happiness & Positivity"},
  {en:"Count your age by friends, not years. Count your life by smiles, not tears.", jp:"年齢を年数ではなく友人たちで数えよ。人生を涙ではなく笑顔で数えよ。", author:"John Lennon", category:"Happiness & Positivity"},
  {en:"Optimism is the faith that leads to achievement. Nothing can be done without hope and confidence.", jp:"楽観主義とは達成へと導く信仰である。希望と自信なしには何事も成し遂げられない。", author:"Helen Keller", category:"Happiness & Positivity"},
  {en:"Joy is what happens to us when we allow ourselves to recognize how good things really are.", jp:"物事がどれほど素晴らしいかを認識することを自分に許したとき、喜びが訪れる。", author:"Marianne Williamson", category:"Happiness & Positivity"},
  {en:"Smile in the mirror. Do that every morning and you'll start to see a big difference in your life.", jp:"鏡に向かって微笑みなさい。毎朝そうすれば、人生に大きな違いが見え始めるだろう。", author:"Yoko Ono", category:"Happiness & Positivity"},
  {en:"The power of finding beauty in the humblest things makes home happy and life lovely.", jp:"最も控えめなものの中に美を見出す力は、家庭を幸せにし、人生を愛おしくする。", author:"Louisa May Alcott", category:"Happiness & Positivity"},
  {en:"Happiness is when what you think, what you say, and what you do are in harmony.", jp:"幸福とは、考えること、言うこと、やる行動が調和している状態のことだ。", author:"Mahatma Gandhi", category:"Happiness & Positivity"},
  {en:"A grateful heart is a magnet for miracles.", jp:"感謝する心は、奇跡を引き寄せる磁石である。", author:"Unknown", category:"Happiness & Positivity"},
  {en:"Let us be grateful to the people who make us happy; they are the charming gardeners who make our souls blossom.", jp:"私たちを幸せにしてくれる人々に感謝しよう。彼らは私たちの魂を開花させてくれる魅力的な庭師なのだ。", author:"Marcel Proust", category:"Happiness & Positivity"},
  {en:"Attitude is a little thing that makes a big difference.", jp:"態度（心の持ちよう）は小さなことだが、大きな違いを生み出す。", author:"Winston Churchill", category:"Happiness & Positivity"},
  {en:"Positive anything is better than negative nothing.", jp:"前向きな何かは、ネガティブな無よりも優れている。", author:"Elbert Hubbard", category:"Happiness & Positivity"},
  {en:"Enjoy the little things, for one day you may look back and realize they were the big things.", jp:"小さなことを楽しみなさい。いつか振り返ったとき、それらが大きなことだったと気づくかもしれないから。", author:"Robert Brault", category:"Happiness & Positivity"},
  {en:"Happiness is a state of mind. It's just according to the way you look at things.", jp:"幸せとは心の状態である。物の見方次第なのだ。", author:"Walt Disney", category:"Happiness & Positivity"},
